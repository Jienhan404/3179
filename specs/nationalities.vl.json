{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: students from the ten largest home countries of international higher-education students in Australia, 2025. Each square is 1 in every 100 of these students; Malaysia is highlighted.",
  "width": 260,
  "height": 260,
  "data": {"url": "data/top10_nationalities_by_state_2025.csv"},
  "transform": [
    {"aggregate": [{"op": "sum", "field": "enrolments", "as": "students"}], "groupby": ["nationality"]},
    {"joinaggregate": [{"op": "sum", "field": "students", "as": "total"}]},
    {"calculate": "100 * datum.students / datum.total", "as": "share"},
    {"window": [{"op": "sum", "field": "share", "as": "cum"}], "sort": [{"field": "students", "order": "descending"}]},
    {"calculate": "round(datum.cum - datum.share)", "as": "lo"},
    {"calculate": "round(datum.cum)", "as": "hi"},
    {"calculate": "sequence(datum.lo, datum.hi)", "as": "cell"},
    {"flatten": ["cell"]},
    {"calculate": "datum.cell % 10", "as": "col"},
    {"calculate": "floor(datum.cell / 10)", "as": "row"},
    {"calculate": "indexof(['China', 'India', 'Nepal', 'Malaysia'], datum.nationality) >= 0 ? datum.nationality : 'Six other countries'", "as": "group"}
  ],
  "layer": [
    {
      "mark": {"type": "rect", "cornerRadius": 3},
      "encoding": {
        "x": {"field": "col", "type": "ordinal", "axis": null, "scale": {"paddingInner": 0.14}},
        "y": {"field": "row", "type": "ordinal", "axis": null, "scale": {"paddingInner": 0.14}},
        "color": {
          "field": "group",
          "type": "nominal",
          "sort": ["China", "India", "Nepal", "Six other countries", "Malaysia"],
          "scale": {
            "domain": ["China", "India", "Nepal", "Six other countries", "Malaysia"],
            "range": ["#6f6e69", "#9a9993", "#bebdb7", "#dfded9", "#2a78d6"]
          },
          "legend": {
            "title": null,
            "orient": "right",
            "symbolType": "square",
            "symbolSize": 160,
            "labelFontSize": 12.5,
            "rowPadding": 8,
            "labelExpr": "{'China': 'China 37', 'India': 'India 23', 'Nepal': 'Nepal 13', 'Six other countries': 'Six other countries 25', 'Malaysia': 'Malaysia 2'}[datum.label]"
          }
        },
        "tooltip": [
          {"field": "nationality", "title": "Home country"},
          {"field": "students", "title": "Students", "format": ","},
          {"field": "share", "title": "Share of the ten countries (%)", "format": ".1f"}
        ]
      }
    }
  ]
}
